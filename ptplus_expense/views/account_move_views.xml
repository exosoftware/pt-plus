<odoo>
    <record id="view_move_form_reimbursement" model="ir.ui.view">
        <field name="name">account.move.form.reimbursement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="before">
                <field name="country_code" invisible="1" />
                <field
                    name="l10n_pt_reimbursement_partner_id"
                    invisible="country_code != 'PT' or not l10n_pt_reimbursement_partner_id"
                    readonly="state != 'draft'"
                />
            </field>
            <div name="button_box" position="inside">
                <field name="l10n_pt_reimbursement_move_id" invisible="1" />
                <button
                    name="action_open_reimbursement_move"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    type="object"
                    invisible="not l10n_pt_reimbursement_move_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Debt Transfer</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Contextual list action to (un)block SAF-T element computation -->
    <record id="action_l10n_pt_toggle_saft_element_move" model="ir.actions.server">
        <field name="name">(Un)block SAF-T element</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_l10n_pt_toggle_saft_element_block()</field>
    </record>

    <record id="action_l10n_pt_toggle_saft_element_payment" model="ir.actions.server">
        <field name="name">(Un)block SAF-T element</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_l10n_pt_toggle_saft_element_block()</field>
    </record>

    <record id="action_l10n_pt_recompute_saft_element_move" model="ir.actions.server">
        <field name="name">Recompute SAF-T element</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_l10n_pt_recompute_saft_element()</field>
    </record>

    <record
        id="action_l10n_pt_recompute_saft_element_payment"
        model="ir.actions.server"
    >
        <field name="name">Recompute SAF-T element</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_l10n_pt_recompute_saft_element()</field>
    </record>
</odoo>

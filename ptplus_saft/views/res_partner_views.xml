<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="partner_saft_imports">
        <field name="name">res.user.saft.imports</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field
                    name="import_saft_id"
                    invisible="1"
                    groups="account.group_account_invoice"
                />
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_import_configuration_ids"
                    icon="fa-cloud-upload"
                    invisible="not import_saft_id"
                    help="Imports"
                    groups="account.group_account_invoice"
                >
                    <field name="no_imports" string="Imports" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>

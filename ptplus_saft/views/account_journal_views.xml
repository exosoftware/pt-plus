<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="journal_saft_imports">
        <field name="name">account.journal.saft.imports</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="import_saft_id" invisible="1" />
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_import_configuration_ids"
                    icon="fa-cloud-upload"
                    invisible="not import_saft_id"
                    help="Imports"
                >
                    <field name="no_imports" string="Imports" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>

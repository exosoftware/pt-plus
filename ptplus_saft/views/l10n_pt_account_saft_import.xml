<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_saft_import_tree" model="ir.ui.view">
        <field name="name">l10n_pt.account.saft.import.list</field>
        <field name="model">l10n_pt.account.saft.import</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="ignore"
                decoration-info="state in ['create', 'update'] and not ignore"
                decoration-success="state in ['created', 'updated']"
                decoration-danger="state == 'error'"
                create="false"
                editable="top"
                multi_edit="1"
            >
                <header>
                    <button
                        name="action_retry_import_errors"
                        type="object"
                        string="Retry"
                    />
                </header>
                <field name="action" />
                <field name="saft_diff" string="Fields" />
                <field name="rec_model_description" string="Model" />
                <field name="rec_model" column_invisible="1" />
                <field name="rec_id" readonly="True" string="Record" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="saft_data" optional="hide" />
                <field name="ignore" readonly="parent_state == 'done' or done" />
                <field
                    name="state"
                    string="Status"
                    widget="badge"
                    decoration-info="state == 'create'"
                    decoration-warning="state == 'update'"
                    decoration-success="state in ['created', 'updated']"
                    decoration-danger="state == 'error'"
                />
                <field name="error_message" optional="show" />
            </list>
        </field>
    </record>

    <record id="account_saft_import_search" model="ir.ui.view">
        <field name="name">l10n_pt.account.saft.import.search</field>
        <field name="model">l10n_pt.account.saft.import</field>
        <field name="arch" type="xml">
            <search string="Search SAF-T PT Import">
                <filter
                    string="Create"
                    name="create"
                    domain="[('action','=', 'create')]"
                />
                <filter
                    string="Update"
                    name="update"
                    domain="[('action','=', 'update')]"
                />
                <filter
                    string="Ignored"
                    name="filter_ignore"
                    domain="[('ignore','=', True)]"
                />
                <filter
                    string="Unignored"
                    name="filter_unignore"
                    domain="[('ignore','=', False)]"
                />
                <filter
                    string="To Do"
                    name="filter_to_do"
                    domain="[('state', 'in', ['create', 'update'])]"
                />
                <filter
                    string="Done"
                    name="filter_done"
                    domain="[('state', 'in', ['created', 'updated'])]"
                />
                <filter
                    string="Errors"
                    name="filter_errors"
                    domain="[('state', '=', 'error')]"
                />
                <group>
                    <filter
                        string="State"
                        name="group_by_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Model"
                        name="group_by_model"
                        context="{'group_by': 'rec_model_id'}"
                    />
                    <filter
                        string="Action"
                        name="group_by_action"
                        context="{'group_by': 'action'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>

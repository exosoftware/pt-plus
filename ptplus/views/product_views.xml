<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_pt" model="ir.ui.view">
        <field name="name">product.template.form.pt</field>
        <field name="model">product.template</field>
        <!-- <field name="priority">5</field>  -->
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="property_account_income_id" position="after">
                <field
                    name="property_account_income_refund_id"
                    domain="[('account_type','in',('income', 'income_other')),('deprecated','=',False)]"
                    groups="account.group_account_invoice"
                />
            </field>
            <field name="property_account_expense_id" position="after">
                <field
                    name="property_account_expense_refund_id"
                    domain="[('account_type','in', ('expense', 'asset_current')),('deprecated','=',False)]"
                    groups="account.group_account_invoice"
                />
            </field>
            <group name="payables" position="after">
                <group
                    string="Tax Classification"
                    groups="account.group_account_invoice"
                >
                    <field name="l10n_pt_genre" />
                    <field name="amount" invisible="l10n_pt_genre != 'IS'" />
                    <field
                        name="amount_type"
                        invisible="l10n_pt_genre != 'IS'"
                        required="l10n_pt_genre == 'IS'"
                    />
                    <field
                        name="pt_vat_country_region"
                        string="Country/Region"
                        invisible="l10n_pt_genre not in ['IVA', 'IS']"
                        required="l10n_pt_genre in ['IVA', 'IS']"
                    />
                    <field
                        name="l10n_pt_sd_code_id"
                        string="Code"
                        invisible="l10n_pt_genre != 'IS'"
                        required="l10n_pt_genre == 'IS'"
                    />
                    <field name="l10n_pt_sd_code" invisible="1" />
                    <field
                        name="l10n_pt_sd_exemption_reason"
                        string="Exemption Reason"
                        invisible="l10n_pt_genre != 'IS' or amount"
                        required="l10n_pt_sd_code == 'IS' and not amount"
                    />
                    <field
                        name="l10n_pt_eco_tax_type"
                        string="Type"
                        invisible="l10n_pt_genre != 'ECO'"
                        required="l10n_pt_genre == 'ECO'"
                    />
                    <field
                        name="l10n_pt_ed_tax_type"
                        string="Type"
                        invisible="l10n_pt_genre != 'IEC'"
                        required="l10n_pt_genre == 'IEC'"
                    />
                </group>
            </group>
        </field>
    </record>

    <record id="view_category_property_form_pt" model="ir.ui.view">
        <field name="name">product.category.property.form.pt</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form" />
        <field name="arch" type="xml">
            <field name="property_account_income_categ_id" position="after">
                <field
                    name="property_account_income_refund_categ_id"
                    domain="[('account_type','in',('income', 'income_other')),('deprecated','=',False)]"
                />
            </field>
            <field name="property_account_expense_categ_id" position="after">
                <field
                    name="property_account_expense_refund_categ_id"
                    domain="[('account_type','in', ('expense', 'asset_current')),('deprecated','=',False)]"
                />
            </field>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--Email template -->
    <record id="email_template_annual_statement" model="mail.template">
        <field name="name">Send Annual Income Statement</field>
        <field
            name="description"
        >Send once a year to suppliers with income/retention values</field>
        <field name="subject">Your {{object.get_period_text()}} Income Statement</field>
        <field name="email_from">{{user.email_formatted}}</field>
        <field name="partner_to">{{ctx.get('partner').id}}</field>
        <field
            name="model_id"
            ref="ptplus_reports_withholding.model_l10n_pt_annual_statement_wizard"
        />
        <field name="auto_delete" eval="False" />
        <field name="lang">{{ ctx['partner'].lang or user.lang }}</field>
        <field
            name="report_template_ids"
            eval="[(4, ref('l10n_pt_report_annual_statement_action'))]"
        />
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="ctx['partner'].name" />,</p>
                <p>Please find attached your
                    <t t-out="object.get_period_text()" />
                    income and retention statement.</p>
                <p>Regards,</p>
            </div>
        </field>
    </record>

</odoo>

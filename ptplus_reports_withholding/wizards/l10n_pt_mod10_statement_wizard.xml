<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_mod10_statement_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.modelo10.statement.wizard.form</field>
        <field name="model">l10n_pt.modelo10.statement.wizard</field>
        <field name="inherit_id" ref="ptplus_reports.l10n_pt_statement_wizard_form" />
        <!--<field name="mode">primary</field>-->
        <field name="type">form</field>
        <field name="arch" type="xml">
            <notebook name="main_block" position="inside">
                <page name="Q4">
                    <group>
                        <field name="q4_line_ids" nolabel="1" colspan="3">
                            <list create="0" delete="0" editable="bottom">
                                <field name="currency_id" column_invisible="1" />
                                <field name="name" />
                                <field name="amount" sum="Total" />
                                <button
                                    name="action_view_details"
                                    type="object"
                                    string="View"
                                    icon="fa-search"
                                />
                            </list>
                        </field>
                        <field name="q4_09" invisible="1" />
                        <field name="q4_12" invisible="1" />
                    </group>
                </page>
                <page name="Q5">
                    <field name="q5_line_ids" nolabel="1" colspan="3">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="1" />
                            <field name="q5_01" />
                            <field
                                name="q5_02_value"
                                sum="q5_02_value"
                                optional="hide"
                            />
                            <field name="q5_02_years" optional="hide" />
                            <field name="q5_02_year" optional="hide" />
                            <field name="q5_03" sum="Total Current Year Income" />
                            <field name="q5_04" />
                            <field name="q5_05" />
                            <field name="q5_06" sum="Total IRS/IRC Withheld" />
                            <field name="q5_07" sum="Total Mandatory Contributions" />
                            <field
                                name="q5_08"
                                sum="Total Union Dues"
                                optional="hide"
                            />
                            <field
                                name="q5_09"
                                sum="Total Surtax Retention (2013-2017)"
                                optional="hide"
                            />
                            <button
                                name="action_view_details"
                                type="object"
                                string="View"
                                icon="fa-search"
                            />
                        </list>
                    </field>
                </page>
                <page name="Q6">
                    <group>
                        <group>
                            <field name="declaration_type" />
                            <field
                                name="q6_03"
                                invisible="declaration_type != 'second'"
                                required="declaration_type == 'second'"
                            />
                            <field
                                name="q6_04"
                                invisible="declaration_type != 'second'"
                                required="declaration_type == 'second'"
                            />
                        </group>
                        <group />
                    </group>
                </page>
                <page name="Q7">
                    <group>
                        <group>
                            <field name="currency_id" column_invisible="1" />
                            <field name="q7_01" />
                            <field name="q7_02" />
                            <field name="q7_03" />
                        </group>
                        <group>
                            <field name="q7_04" />
                            <field name="q7_05" />
                            <field name="q7_accountant_substitute" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="l10n_pt_mod10_statement_wizard_action" model="ir.actions.act_window">
        <field name="name">Modelo 10</field>
        <field name="res_model">l10n_pt.modelo10.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_pt_mod10_statement_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_pt_mod10_statement_wizard_menu"
        parent="ptplus_reports_withholding.l10n_pt_income_retention_menu"
        sequence="10"
        groups="account.group_account_user,account.group_account_user"
        action="l10n_pt_mod10_statement_wizard_action"
    />
</odoo>

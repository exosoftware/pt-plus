<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_mod10_statement_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.modelo10.statement.wizard.form</field>
        <field name="model">l10n_pt.modelo10.statement.wizard</field>
        <field name="inherit_id" ref="ptplus_reports.l10n_pt_statement_wizard_form" />
        <!--<field name="mode">primary</field>-->
        <field name="type">form</field>
        <field name="arch" type="xml">
            <group name="options_left" position="inside">
                <field
                    name="tax_office_code"
                    help="[Q1-C01] The 4-digit tax office code"
                />
                <field
                    name="declaration_type"
                    help="[Q6-C01,C02] Select whether this is the first declaration for the given period or a replacement."
                />
                <field
                    name="is_under_art_119_1d"
                    invisible="declaration_type != 'subst'"
                    help="[Q6-C03] Set true if this declaration is being submitted under Art. 119º nº 1d"
                />
                <field
                    name="subst_fact_date"
                    invisible="declaration_type != 'subst'"
                    required="declaration_type == 'subst'"
                    help="[Q6-C04] Date of the event that triggered the obligation to declare or amend income already declared"
                />
            </group>
            <group name="options_right" position="inside">
                <field
                    name="certified_accountant_vat"
                    help="[Q7-C01] Certified Accountant VAT No."
                />
                <field
                    name="is_alternate_accountant"
                    help="[Q7-C06,C07] Set True if the accountant is a substitute of the official one."
                />
                <field
                    name="justifiable_reason"
                    help="[Q7-C03] Fact that originated the justifiable reason"
                />
                <field
                    name="justifiable_reason_start_date"
                    help="[Q7-C04] Date of the fact that originated the justifiable reason"
                    invisible="not justifiable_reason"
                />
                <field
                    name="justifiable_reason_end_date"
                    help="[Q7-C05] Date on which the fact that originated the justifiable reason ceased to exist"
                    invisible="not justifiable_reason"
                />
                <field
                    name="legal_representative_vat"
                    help="[Q7-C02] Legal representative or taxable person VAT No."
                />
            </group>
            <notebook name="main_block" position="inside">
                <page name="Q4">
                    <group>
                        <field name="q4_line_ids" nolabel="1" colspan="2">
                            <list create="0" delete="0" editable="bottom">
                                <field name="currency_id" column_invisible="1" />
                                <field name="display_name" string="Name" readonly="1" />
                                <field name="amount" sum="Total" />
                                <button
                                    name="action_view_details"
                                    type="object"
                                    string="View"
                                    icon="fa-search"
                                />
                            </list>
                        </field>
                        <field name="q4_09" invisible="1" />
                        <field name="q4_12" invisible="1" />
                    </group>
                </page>
                <page name="Q5">
                    <field name="q5_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="1" />
                            <field name="q5_01" />
                            <field
                                name="q5_02_value"
                                sum="q5_02_value"
                                optional="hide"
                            />
                            <field name="q5_02_years" optional="hide" />
                            <field name="q5_02_year" optional="hide" />
                            <field name="q5_03" sum="Total Current Year Income" />
                            <field name="q5_04" />
                            <field name="q5_05" />
                            <field name="q5_06" sum="Total IRS/IRC Withheld" />
                            <field name="q5_07" sum="Total Mandatory Contributions" />
                            <field
                                name="q5_08"
                                sum="Total Union Dues"
                                optional="hide"
                            />
                            <field
                                name="q5_09"
                                sum="Total Surtax Retention (2013-2017)"
                                optional="hide"
                            />
                            <button
                                name="action_view_details"
                                type="object"
                                string="View"
                                icon="fa-search"
                            />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="l10n_pt_mod10_statement_wizard_action" model="ir.actions.act_window">
        <field name="name">Modelo 10</field>
        <field name="res_model">l10n_pt.modelo10.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_pt_mod10_statement_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_pt_mod10_statement_wizard_menu"
        parent="ptplus_reports_withholding.l10n_pt_income_retention_menu"
        sequence="10"
        groups="account.group_account_user,account.group_account_user"
        action="l10n_pt_mod10_statement_wizard_action"
    />
</odoo>

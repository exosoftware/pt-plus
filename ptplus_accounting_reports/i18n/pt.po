#. module: ptplus_accounting_reports
#. odoo-python
#: code:addons/ptplus_accounting_reports/wizards/l10n_pt_vat_periodic_statement_wizard.py:0
msgid ""
"Annex %(annex)s - the annex rows add up to %(total)s while field %(annex)s "
"holds %(field)s. Adjustments under norms outside the annex, or without a "
"norm, explain the difference."
msgstr ""
"Anexo %(annex)s - as linhas do anexo somam %(total)s e o campo %(annex)s tem "
"%(field)s. Regularizações com normas fora do anexo, ou sem norma, explicam a "
"diferença."

#. module: ptplus_accounting_reports
#. odoo-python
#: code:addons/ptplus_accounting_reports/wizards/l10n_pt_vat_periodic_statement_wizard.py:0

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_trial_balance_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.trial.balance.wizard.form</field>
        <field name="model">l10n_pt.trial.balance.wizard</field>
        <field name="inherit_id" ref="ptplus_reports.l10n_pt_statement_wizard_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <group name="main_left" position="inside">
                <field
                    name="include_draft"
                    widget="boolean_toggle"
                    readonly="state != 'select'"
                />
            </group>
            <group name="main" position="after">
                <group
                    name="trial_balance_options"
                    string="Options"
                    invisible="state != 'select'"
                >
                    <div class="o_row" colspan="2">
                        <label for="before_pl_calculation" />
                        <field name="before_pl_calculation" widget="boolean_toggle" />
                        <label class="ps-5" for="show_partner_breakdown" />
                        <field name="show_partner_breakdown" widget="boolean_toggle" />
                        <label class="ps-5" for="show_product_breakdown" />
                        <field name="show_product_breakdown" widget="boolean_toggle" />
                    </div>
                </group>
            </group>
            <notebook name="main_block" position="inside">
                <page name="Statement Lines" string="Accounts">
                    <field name="line_ids" nolabel="1" colspan="2">
                        <list create="0" delete="0" decoration-bf="not account_id">
                            <field name="account_id" column_invisible="1" />
                            <field name="domain" column_invisible="1" />
                            <field name="code" string="Code" />
                            <field name="display_name" string="Account" readonly="1" />
                            <field name="initial_balance" />
                            <field name="debit" />
                            <field name="credit" />
                            <field name="amount" string="Final Balance" />
                            <button
                                name="action_view_details"
                                type="object"
                                string="View"
                                icon="fa-search"
                                invisible="not domain"
                            />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="l10n_pt_trial_balance_wizard_action" model="ir.actions.act_window">
        <field name="name">Trial Balance</field>
        <field name="res_model">l10n_pt.trial.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_pt_trial_balance_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_pt_financial_statement_menu"
        parent="l10n_pt.account_reports_pt_statements_menu"
        sequence="140"
        groups="account.group_account_user"
        name="Financial"
    />

    <menuitem
        id="l10n_pt_trial_balance_wizard_menu"
        parent="ptplus_accounting_reports.l10n_pt_financial_statement_menu"
        sequence="10"
        action="l10n_pt_trial_balance_wizard_action"
    />
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_profit_loss_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.profit.loss.wizard.form</field>
        <field name="model">l10n_pt.profit.loss.wizard</field>
        <field name="inherit_id" ref="ptplus_reports.l10n_pt_statement_wizard_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <group name="main" position="after">
                <group
                    name="error_analyze"
                    string="Errors"
                    invisible="state != 'analyze' or not warnings"
                >
                    <field
                        name="warnings"
                        readonly="1"
                        widget="html"
                        nolabel="1"
                        colspan="2"
                    />
                </group>
            </group>
            <group name="main_left" position="inside">
                <field name="chart_template" readonly="state != 'select'" />
                <!--                <field name="exclude_pl_calc" readonly="state != 'select'" />-->
                <field name="include_draft" readonly="state != 'select'" />
            </group>
            <notebook name="main_block" position="inside">
                <page name="Statement Lines">
                    <field name="line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="code" />
                            <field name="display_name" string="Name" readonly="1" />
                            <field name="amount" />
                            <button
                                name="action_view_details"
                                type="object"
                                string="View"
                                icon="fa-search"
                            />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="l10n_pt_profit_loss_wizard_action" model="ir.actions.act_window">
        <field name="name">Profit &amp; Loss</field>
        <field name="res_model">l10n_pt.profit.loss.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_pt_profit_loss_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_pt_profit_loss_wizard_menu"
        parent="ptplus_accounting_reports.l10n_pt_financial_statement_menu"
        sequence="30"
        action="l10n_pt_profit_loss_wizard_action"
    />
</odoo>

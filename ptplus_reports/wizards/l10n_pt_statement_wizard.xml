<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_pt_statement_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.statement.wizard.form</field>
        <field name="model">l10n_pt.statement.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form name="Options">
                <field name="state" invisible="1" />
                <field name="filename" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="show_button_compute" invisible="1" />
                <field name="show_button_export_pdf" invisible="1" />
                <field name="show_button_export_xml" invisible="1" />
                <field name="show_button_export_txt" invisible="1" />
                <field name="show_button_export_xlsx" invisible="1" />
                <field name="show_button_export_csv" invisible="1" />
                <field name="show_button_export_webservice" invisible="1" />
                <field name="show_button_print" invisible="1" />
                <field name="show_button_mail" invisible="1" />
                <group name="main" attrs="{'invisible': [('state', '=', 'done')]}">
                    <group name="main_left">
                        <field
                            name="company_id"
                            options="{'no_create_edit': True}"
                            groups="base.group_multi_company"
                        />
                        <field
                            name="period"
                            attrs="{'readonly': [('state', '!=', 'select')]}"
                        />
                        <field
                            name="date_from"
                            string="From"
                            attrs="{'invisible': [('period', '!=', 'custom')], 'readonly': [('state', '!=', 'select')]}"
                        />
                        <field
                            name="date_to"
                            string="To"
                            attrs="{'invisible': [('period', '!=', 'custom')], 'readonly': [('state', '!=', 'select')]}"
                        />
                    </group>
                </group>
                <group
                    name="options"
                    string="Options"
                    attrs="{'invisible': [('state', '!=', 'analyze')]}"
                >
                    <group name="options_left">
                    </group>
                    <group name="options_right">
                    </group>
                </group>
                <notebook
                    attrs="{'invisible': [('state', '!=', 'analyze')]}"
                    name="main_block"
                >
                </notebook>
                 <div attrs="{'invisible': [('state', '!=', 'done')]}">
                    <h2>Export Complete</h2>
                    <p>
                        Generated file: <field
                            name="data"
                            readonly="1"
                            filename="filename"
                        />
                    </p>
                </div>
                <group
                    name="error_info"
                    string="Errors"
                    attrs="{'invisible': [('state', '!=', 'done')]}"
                >
                    <field
                        name="warnings"
                        readonly="1"
                        widget="html"
                        nolabel="1"
                        colspan="2"
                    />
                </group>
                <group
                    name="log_info"
                    string="Log info"
                    attrs="{'invisible': [('state', '!=', 'done')]}"
                >
                    <field name="log_on_close" />
                    <field name="log_as_reported" />
                </group>
                <footer>
                    <button
                        name="action_compute"
                        string="Compute"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': ['|', ('show_button_compute', '=', False), ('state', '!=', 'select')]}"
                    />
                    <button
                        name="export_xml"
                        type="object"
                        class="oe_highlight"
                        string="Export XML"
                        attrs="{'invisible':['|', ('show_button_export_xml','=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        name="export_pdf"
                        type="object"
                        class="oe_highlight"
                        string="Export PDF"
                        attrs="{'invisible':['|', ('show_button_export_pdf','=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        name="export_txt"
                        type="object"
                        class="oe_highlight"
                        string="Export TXT"
                        attrs="{'invisible':['|', ('show_button_export_txt','=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        name="export_xlsx"
                        type="object"
                        class="oe_highlight"
                        string="Export XLSX"
                        attrs="{'invisible':['|', ('show_button_export_xlsx','=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        name="export_csv"
                        type="object"
                        class="oe_highlight"
                        string="Export CSV"
                        attrs="{'invisible':['|', ('show_button_export_csv','=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        name="export_webservice"
                        type="object"
                        class="oe_highlight"
                        string="Export Webservice"
                        attrs="{'invisible':['|', ('show_button_export_webservice','=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        name="action_send_mail"
                        string="Send by E-mail"
                        type="object"
                        class="btn-primary"
                        confirm="Are you sure you want to send emails to the selected records?"
                        attrs="{'invisible': ['|', ('show_button_mail', '=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        name="action_print"
                        string="Print"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', ('show_button_print', '=', False), ('state', '!=', 'analyze')]}"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                        attrs="{'invisible': [('state', '=', 'done')]}"
                    />

                    <button
                        name="go_back"
                        type="object"
                        string="Previous"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                    />

                    <button
                        name="close"
                        type="object"
                        string="Close"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>

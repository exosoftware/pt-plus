<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="ptplus_sdr_pos.ControlButtons"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']"
            position="before"
        >
            <t
                t-call="point_of_sale.controlButton"
                t-if="this.displayL10nPtSdrRecomputeBtn()"
                name="o_l10n_pt_sdr_recompute_button"
                icon="'refresh'"
                btnText.translate="Compute SDR"
                btnClasses="'o_l10n_pt_sdr_recompute_button btn-secondary '"
                onClick="() => this.clickL10nPtSdrRecompute()"
            />
        </xpath>
    </t>
</templates>

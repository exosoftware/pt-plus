<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_l10n_pt_edi_send_scheduled" model="ir.cron">
        <field name="name">PT EDI: Send scheduled e-invoices</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="state">code</field>
        <field name="code">model._cron_l10n_pt_edi_send_scheduled()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
            name="nextcall"
            eval="(DateTime.now().replace(hour=21, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
        />
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Invoice document mods -->
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- Information zone fields -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.l10n_pt_commitment_number">
                <strong>Commitment No.</strong>
                <div t-field="o.l10n_pt_commitment_number">12345</div>
            </div>
            <div class="col" t-if="o.l10n_pt_fitting_number">
                <strong>Fitting No.</strong>
                <div t-field="o.l10n_pt_fitting_number">99999</div>
            </div>
        </xpath>
    </template>
</odoo>

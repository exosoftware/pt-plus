<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="dataport_import_form_efatura" model="ir.ui.view">
        <field name="name">l10n_pt.dataport.import.efatura.form</field>
        <field name="model">l10n_pt.dataport.import.efatura</field>
        <field name="inherit_id" ref="ptplus.dataport_import_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="journal_id" />
            </field>
            <field name="date_to" position="after">
                <field name="data" position="move" />
                <field name="create_invoices" />
            </field>

            <button name="action_import" position="before">
                <button
                    name="action_sync"
                    type="object"
                    class="oe_highlight"
                    string="Synchronize"
                    help="Obtain e-fatura data online. If you prefer to import a csv file, just load it above"
                    invisible="data"
                />
            </button>
            <button name="action_import" position="attributes">
                <attribute name="invisible">not data</attribute>
            </button>

            <group name="error_info" position="after">
                <field name="mapping_missing_ids" invisible="1" />
                <div class="mt8" invisible="state != 'done' or not mapping_missing_ids">
                    <button
                        name="action_open_mapping_missing"
                        type="object"
                        icon="fa-arrow-right"
                        string="Documents Missing a Tax Mapping"
                        class="btn-link"
                    />
                    <button
                        name="action_open_tax_mapping"
                        type="object"
                        icon="fa-arrow-right"
                        string="Configure Mappings"
                        class="btn-link"
                    />
                </div>
            </group>

            <div invisible="state != 'done'" position="before">
                <div
                    class="alert alert-info d-flex align-items-center"
                    role="alert"
                    invisible="state != 'running'"
                >
                    <i class="fa fa-circle-o-notch fa-spin me-2" />
                    <span class="me-1">Synchronizing with the Tax Authority:</span>
                    <!-- The widget on this field subscribes to the run's bus
                         channel and reloads the dialog when the cron is done.
                         It has to sit on a rendered field: the state one is
                         invisible on the inherited form. -->
                    <field name="sync_stage" widget="efatura_sync_stage" nolabel="1" />
                </div>
            </div>
            <footer invisible="state != 'done'" position="after">
                <footer invisible="state != 'running'">
                    <button special="cancel" string="Close" />
                </footer>
            </footer>
        </field>
    </record>

    <record id="dataport_import_efatura_action" model="ir.actions.act_window">
        <field name="name">Import E-Fatura</field>
        <field name="res_model">l10n_pt.dataport.import.efatura</field>
        <field name="view_id" ref="dataport_import_form_efatura" />
        <field name="target">new</field>
        <field name="context">{'type': 'in_invoice'}</field>
    </record>
</odoo>

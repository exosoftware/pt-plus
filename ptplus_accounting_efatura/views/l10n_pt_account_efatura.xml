<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_efatura_tree" model="ir.ui.view">
        <field name="name">l10n_pt.account.efatura.list</field>
        <field name="model">l10n_pt.account.efatura</field>
        <field name="arch" type="xml">
            <list
                js_class="l10n_pt_efatura_list"
                create="0"
                decoration-success="invoice_id and not status_mismatch and not mapping_missing"
                decoration-danger="status_mismatch"
                decoration-warning="mapping_missing and not status_mismatch"
                decoration-muted="not invoice_id and not status_mismatch and not mapping_missing"
            >
                <field name="status_mismatch" column_invisible="True" />
                <field name="mapping_missing" column_invisible="True" />
                <field name="date" />
                <field name="reference" />
                <field name="vendor_id" />
                <!--<field name="vendor_name" />-->
                <field name="vat" />
                <field name="type" />
                <field name="status" />
                <field name="vat_amount" />
                <field name="total_amount" />
                <field name="tax_base" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="invoice_id" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="account_efatura_form" model="ir.ui.view">
        <field name="name">l10n_pt.account.efatura.form</field>
        <field name="model">l10n_pt.account.efatura</field>
        <field name="arch" type="xml">
            <form>
                <div
                    class="alert alert-danger text-center"
                    invisible="not status_mismatch"
                    role="alert"
                >
                    <field name="status_mismatch_text" />
                </div>
                <div
                    class="alert alert-warning text-center"
                    invisible="not mapping_missing"
                    role="alert"
                >
                    <field name="mapping_missing_text" />
                </div>
                <header />
                <sheet>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="reference" />
                            <field name="vendor_id" />
                            <field name="vendor_name" />
                            <field name="vat" />
                            <field name="type" />
                            <field name="atcud" />
                            <field name="tax_auth_doc_id" string="AT ID" />
                            <field name="sector" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            />
                        </group>
                        <group>
                            <field name="status" />
                            <field name="self_billing" />
                            <field name="cash_vat_scheme" />
                            <field name="status_mismatch" invisible="1" />
                            <field name='vat_amount' />
                            <field name="tax_amount" />
                            <field name='total_amount' />
                            <field name="tax_base" />
                            <field
                                name='company_id'
                                groups="base.group_multi_company"
                            />
                            <label for="invoice_id" string="Document" />
                            <div class="o_row" name="invoice_id_row">
                                <field
                                    name="invoice_id"
                                    nolabel="1"
                                    domain="[('move_type', 'in', ('in_invoice', 'in_refund')), ('l10n_pt_efatura_id', '=', False)]"
                                    options="{'no_create': True, 'no_edit': True}"
                                />
                                <button
                                    name="%(action_account_invoice_efatura)d"
                                    type="action"
                                    string="Create Bill"
                                    help="Create the vendor bill of this document, with the product and the tax of the E-Fatura tax mapping"
                                    class="btn-link mb-1 px-0"
                                    icon="fa-plus"
                                    invisible="invoice_id or self_billing"
                                />
                            </div>
                            <field name="status_mismatch_disable" />
                        </group>
                        <notebook>
                            <page string="e-Fatura Lines" name="efaturas_lines">
                                <field name="line_ids" mode="list" nolabel="1">
                                    <list editable="bottom">
                                        <field name="amount_base" string="Tax Base" />
                                        <field name="tax_percentage" string="Tax %" />
                                        <field name="amount_tax" string="VAT" />
                                        <field name="amount_total" string="Total" />
                                        <field name="tax_genre" optional="show" />
                                        <field name="vat_tax_type" optional="show" />
                                        <field
                                            name="exemption_reason"
                                            optional="show"
                                        />
                                        <field name="tax_verba" optional="show" />
                                        <field name="country_id" optional="hide" />
                                        <field name="region" optional="hide" />
                                        <button
                                            name="l10n_pt_action_create_mapping"
                                            type="object"
                                            icon="fa-plus"
                                            title="Create the tax mapping for this line"
                                        />
                                        <field
                                            name="mapping_missing"
                                            widget="l10n_pt_efatura_mapping_missing"
                                            string=" "
                                        />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="account_efatura_search" model="ir.ui.view">
        <field name="name">l10n_pt.account.efatura.search</field>
        <field name="model">l10n_pt.account.efatura</field>
        <field name="arch" type="xml">
            <search string="Search E-Fatura">
                <field name="reference" />
                <field name="vat" />
                <filter
                    string="Unlinked"
                    name="unlinked"
                    domain="[('invoice_id','=',False)]"
                />
                <filter
                    string="Status Mismatch"
                    name="status_mismatch_filter"
                    domain="[('status_mismatch','=',True)]"
                />
                <filter
                    string="Missing Tax Mapping"
                    name="mapping_missing_filter"
                    domain="[('mapping_missing','=',True)]"
                />
                <group>
                    <filter string="Date" name="date" context="{'group_by': 'date'}" />
                    <filter
                        string="Vendor"
                        name="vendor"
                        context="{'group_by': 'vendor_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_efatura_view" model="ir.actions.act_window">
        <field name="name">E-Fatura</field>
        <field name="res_model">l10n_pt.account.efatura</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account_efatura_tree" />
    </record>

    <menuitem
        id="menu_account_efatura_list"
        parent="account.menu_finance_entries"
        action="action_account_efatura_view"
    />
</odoo>

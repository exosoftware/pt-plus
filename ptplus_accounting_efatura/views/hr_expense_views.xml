<odoo>
    <record id="hr_expense_view_form_efatura_scan" model="ir.ui.view">
        <field name="name">hr.expense.form.efatura.scan</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_split_wizard']" position="before">
                <field name="l10n_pt_efatura_scan" invisible="1" />
                <field name="l10n_pt_country_code" invisible="1" />
                <field name="l10n_pt_efatura_id" invisible="1" />
                <button
                    name="l10n_pt_action_scan"
                    string="Scan QR"
                    type="object"
                    class="btn-primary"
                    icon="fa-qrcode"
                    help="Look for an e-fatura QR code on the expense receipt and fill the expense fields from its data"
                    invisible="l10n_pt_country_code != 'PT' or not l10n_pt_efatura_scan or state != 'draft' or nb_attachment &lt; 1 or total_amount_currency != 0"
                />
                <button
                    name="l10n_pt_action_scan"
                    string="Scan QR"
                    type="object"
                    class="btn-secondary"
                    icon="fa-qrcode"
                    help="Look for an e-fatura QR code on the expense receipt and fill the expense fields from its data"
                    invisible="l10n_pt_country_code != 'PT' or not l10n_pt_efatura_scan or state != 'draft' or nb_attachment &lt; 1 or total_amount_currency == 0"
                />
            </xpath>
            <!-- The tax breakdown of the expense lives in its e-fatura
                 record: the native single-value tax fields are misleading
                 (e.g. multi-rate receipts) so hide them -->
            <xpath expr="//label[@for='tax_ids']" position="attributes">
                <attribute
                    name="invisible"
                >l10n_pt_country_code == 'PT' and l10n_pt_efatura_id</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_ids']/.." position="attributes">
                <attribute
                    name="invisible"
                >l10n_pt_country_code == 'PT' and l10n_pt_efatura_id</attribute>
            </xpath>
            <xpath
                expr="//field[@name='total_amount_currency']/../span"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >tax_amount == 0 or (l10n_pt_country_code == 'PT' and l10n_pt_efatura_id)</attribute>
            </xpath>
        </field>
    </record>
</odoo>

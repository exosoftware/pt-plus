"%(in_c)s invoices created. %(in_u)s invoices updated.\n"
"%(cn_c)s credit notes created. %(cn_u)s credit notes updated."
"in_cbills_created"
msgstr ""
"%(in_c)s faturas criadas. %(in_u)s faturas atualizadas.\n"
"%(cn_c)s notas de crédito criadas. %(cn_u)s notas de crédito atualizadas."
"in_cbills_created"


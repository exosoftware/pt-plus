<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-name="button_efatura.ListView.Buttons" t-inherit="web.ListView.Buttons">
        <xpath expr="." position="inside">
            <button
                t-if="!this.hasSelectedRecords"
                type="button"
                class="btn btn-primary"
                t-on-click="this.importEfatura"
            >
           Import
        </button>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[@id['l10n_pt_doc_name']]" position="after">
            <div
                t-if="order.l10n_pt_bill_doc_name and !order.l10n_pt_doc_name"
                t-esc="order.l10n_pt_bill_doc_name"
            />
        </xpath>
    </t>

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <div
                id="pt_qrbox"
                t-if="order.l10n_pt_bill_qr_code and !order.l10n_pt_qr_code"
            >
                <div id="atcud">
                    <span>ATCUD:</span>
                    <span t-esc="order.l10n_pt_bill_atcud" />
                </div>
                <img
                    id="pt_qrcode"
                    t-att-src="order.l10n_pt_generateQRCode(order.l10n_pt_bill_qr_code)"
                    class="pt_qrcode"
                />
            </div>
            <div
                class="pos-receipt-contact"
                t-if="order.l10n_pt_bill_qr_code and !order.l10n_pt_qr_code"
            >
                <t t-esc="order.l10n_pt_bill_certification_text" />
            </div>
        </xpath>
    </t>

</templates>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_sdr" model="ir.ui.view">
        <field name="name">sale.order.form.sdr</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button
                    name="action_l10n_pt_sdr_recompute"
                    id="action_l10n_pt_sdr_recompute"
                    string="Recompute SDR"
                    type="object"
                    invisible="state not in ('draft', 'sent') or not l10n_pt_sdr_has_flagged_line or not l10n_pt_sdr_auto_compute"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="l10n_pt_sdr_base_qty" invisible="1" />
                <field name="l10n_pt_sdr_has_flagged_line" invisible="1" />
                <field name="l10n_pt_sdr_auto_compute" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>

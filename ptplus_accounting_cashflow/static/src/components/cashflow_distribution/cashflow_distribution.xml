<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ptplus_accounting_cashflow.CashflowDistribution">
        <div
            class="o_field_tags d-inline-flex flex-wrap mw-100"
            t-att-class="{'o_tags_input o_input': this.editingRecord}"
            t-ref="this.widgetRef"
            t-on-keydown="this.onWidgetKeydown"
        >
            <t t-foreach="this.summaryTags()" t-as="tag" t-key="tag.id">
                <BadgeTag
                    color="tag.colorIndex"
                    text="tag.text"
                    tooltip="tag.title"
                    onClick="tag.onClick"
                />
            </t>
            <div
                t-if="this.editingRecord"
                class="o_input_dropdown d-inline-flex w-100"
                tabindex="0"
                t-ref="this.mainRef"
                t-on-focus="this.onMainElementFocus"
                t-on-click="this.onMainElementFocus"
            >
                <span class="cashflow_distribution_placeholder">
                    <t
                        t-if="!this.state.formattedData.length"
                        t-out="this.props.placeholder"
                    />
                </span>
                <span class="o_dropdown_button" />
                <t t-call="ptplus_accounting_cashflow.CashflowDistributionPopup" />
            </div>
        </div>
    </t>

    <t t-name="ptplus_accounting_cashflow.CashflowDistributionPopup">
        <div
            class="popover cashflow_distribution_popup dropdown-menu o-dropdown--menu show rounded py-0 overflow-x-hidden"
            t-if="this.state.showDropdown"
            t-ref="this.dropdownRef"
        >
            <div class="popover-header sticky-top">
                <div class="d-flex">
                    <div class="h5 mt-2 me-auto">Cash Flow</div>
                    <div class="popupButtons">
                        <span
                            class="btn o_button"
                            t-on-click.stop="() => this.closeCashflowEditor()"
                            title="Close"
                        >
                            <span class="oi" data-icon="close" />
                        </span>
                    </div>
                </div>
            </div>
            <div class="popover-body p-2 table-responsive" style="max-width: 100vw;">
                <table
                    class="o_list_table table table-sm table-hover o_cashflow_table mb-2 table-striped"
                >
                    <thead>
                        <tr class="border-bottom">
                            <th>Category</th>
                            <th
                                t-if="this.percentageColumnEnabled"
                                class="numeric_column_width"
                            >Percentage</th>
                            <th
                                class="numeric_column_width"
                                t-out="this.props.record.fields[this.props.amount_field].string"
                            />
                            <th class="deleteColumn w-20px" />
                        </tr>
                    </thead>
                    <tbody>
                        <tr
                            t-foreach="this.state.formattedData"
                            t-as="line"
                            t-key="line.id"
                            t-att-id="line_index"
                            t-att-name="'line_' + line_index"
                        >
                            <Record
                                t-props="this.recordProps(line)"
                                t-slot-scope="data"
                            >
                                <td>
                                    <Field
                                        id="'category_id'"
                                        name="'category_id'"
                                        record="data.record"
                                        canOpen="false"
                                        canCreate="false"
                                        canCreateEdit="false"
                                        canQuickCreate="false"
                                    />
                                </td>
                                <td
                                    t-if="this.percentageColumnEnabled"
                                    class="numeric_column_width"
                                >
                                    <Field
                                        id="'percentage'"
                                        name="'percentage'"
                                        record="data.record"
                                    />
                                </td>
                                <td class="numeric_column_width">
                                    <Field
                                        id="'amount'"
                                        name="'amount'"
                                        record="data.record"
                                    />
                                </td>
                                <td class="w-20px">
                                    <span
                                        class="oi cursor-pointer"
                                        data-icon="delete"
                                        t-on-click.stop="() => this.deleteLine(line_index)"
                                    />
                                </td>
                            </Record>
                        </tr>
                        <tr>
                            <td
                                t-on-click.stop.prevent="this.addLine"
                                class="o_field_x2many_list_row_add"
                                t-att-colspan="this.percentageColumnEnabled ? 4 : 3"
                            >
                                <a
                                    href="#"
                                    t-ref="this.addLineButton"
                                    tabindex="0"
                                >Add a line</a>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="border-top">
                            <th
                                t-att-colspan="this.percentageColumnEnabled ? 2 : 1"
                            >Total</th>
                            <th
                                class="numeric_column_width"
                                t-att-class="this.isBalanced ? 'text-success' : this.isOverAllocated ? 'text-danger' : 'text-warning'"
                            >
                                <t t-out="this.formatAmount(this.distributionTotal)" />
                                /
                                <t t-out="this.formatAmount(this.referenceAmount)" />
                            </th>
                            <th class="w-20px" />
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>

</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ptplus_accounting_cashflow.CashflowCategoryField">
        <t t-if="this.props.readonly">
            <span
                t-if="this.tag"
                t-attf-class="o_tag o_badge badge rounded-pill o_tag_color_{{ this.tag.color }}"
                t-att-data-tooltip="this.tag.title"
                t-out="this.tag.label"
            />
            <!-- Empty: the placeholder as the red tag of the distribution widget -->
            <span
                t-elif="this.props.placeholder"
                class="o_tag o_badge badge rounded-pill o_tag_color_1"
                t-out="this.props.placeholder"
            />
        </t>
        <Many2One t-else="" t-props="this.m2oProps" />
    </t>
</templates>

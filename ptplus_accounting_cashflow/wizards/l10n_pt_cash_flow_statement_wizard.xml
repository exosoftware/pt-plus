<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_pt_cash_flow_statement_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt.cash.flow.statement.wizard.form</field>
        <field name="model">l10n_pt.cash.flow.statement.wizard</field>
        <field name="inherit_id" ref="ptplus_reports.l10n_pt_statement_wizard_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <group name="main" position="after">
                <group
                    name="warnings_analyze"
                    string="Warnings"
                    invisible="state != 'analyze' or not warnings"
                >
                    <field
                        name="warnings"
                        readonly="1"
                        widget="html"
                        nolabel="1"
                        colspan="2"
                    />
                    <field name="unclassified_count" invisible="1" />
                    <button
                        name="action_view_unclassified_lines"
                        type="object"
                        string="View Movements To Classify"
                        icon="fa-search"
                        class="btn-secondary"
                        invisible="not unclassified_count"
                        colspan="2"
                    />
                </group>
            </group>
            <group name="main_left" position="inside">
                <field name="chart_template" readonly="state != 'select'" />
                <field name="include_draft" widget="boolean_toggle" />
                <field name="unavailable_cash_amount" readonly="state != 'select'" />
            </group>
            <notebook name="main_block" position="inside">
                <page name="q04b" string="Q04-B - Cash Flow Statement">
                    <field name="q04b_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="code" />
                            <field name="display_name" string="Name" readonly="1" />
                            <field name="amount" />
                            <button
                                name="action_view_details"
                                type="object"
                                string="View"
                                icon="fa-search"
                            />
                        </list>
                    </field>
                </page>
                <page name="q0701" string="Q0701 - Additional Information">
                    <field name="q0701_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="code" />
                            <field name="display_name" string="Name" readonly="1" />
                            <field name="amount" />
                            <button
                                name="action_view_details"
                                type="object"
                                string="View"
                                icon="fa-search"
                            />
                        </list>
                    </field>
                    <group>
                        <field name="other_relevant_info" colspan="2" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record
        id="l10n_pt_cash_flow_statement_wizard_action"
        model="ir.actions.act_window"
    >
        <field name="name">Cash Flow Statement</field>
        <field name="res_model">l10n_pt.cash.flow.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_pt_cash_flow_statement_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_pt_cash_flow_statement_wizard_menu"
        parent="ptplus_accounting_reports.l10n_pt_financial_statement_menu"
        sequence="40"
        action="l10n_pt_cash_flow_statement_wizard_action"
    />
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref='account.view_account_payment_register_form' />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='group1']/field[@name='partner_bank_id']"
                position="after"
            >
                <field name="l10n_pt_cope_partner_country_code" invisible="1" />
                <field
                    name="l10n_pt_cope_code_id"
                    invisible="l10n_pt_cope_partner_country_code == 'PT'"
                />
                <field name="l10n_pt_cope_show_active_country" invisible="1" />
                <field
                    name="l10n_pt_cope_active_country_id"
                    invisible="not l10n_pt_cope_show_active_country"
                />
            </xpath>
        </field>
    </record>
</odoo>

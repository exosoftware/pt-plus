<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <setting
                    id="pos_invoice_doc_pt"
                    company_dependent="1"
                    help="The portuguese fiscal document to apply on this POS invoices. Only the document types marked as Point of Sale are listed."
                >
                    <field
                        name="pos_l10n_pt_inv_fiscal_doc_type_id"
                        options="{'no_create': True}"
                        readonly="pos_has_active_session"
                    />
                </setting>

                <setting
                    id="pos_credit_note_doc_pt"
                    company_dependent="1"
                    help="The portuguese fiscal document to apply on this POS credit notes. Only the document types marked as Point of Sale are listed."
                >
                    <field
                        name="pos_l10n_pt_cred_fiscal_doc_type_id"
                        options="{'no_create': True}"
                        readonly="pos_has_active_session"
                    />
                </setting>

                <setting
                    id="pos_bill_doc_pt"
                    company_dependent="1"
                    help="The portuguese fiscal document to apply on this POS bills. Only the document types marked as Point of Sale are listed."
                    invisible="not pos_iface_printbill"
                >
                    <field
                        name="pos_l10n_pt_bill_fiscal_doc_type_id"
                        options="{'no_create': True}"
                        readonly="pos_has_active_session"
                        domain="[('source_billing', '=', 'P'),
                                ('type', '=', 'CM' if pos_module_pos_restaurant else 'OR'),
                                ('sequence_id', '!=', False),
                                ('point_of_sale', '=', True)]"
                    />
                </setting>

                <setting
                    id="pos_l10n_pt_default_partner_id"
                    company_dependent="1"
                    help="Default customer to use if none is set"
                >
                    <field name="pos_l10n_pt_default_partner_id" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

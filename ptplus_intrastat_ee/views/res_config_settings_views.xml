<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_intrastat" model="ir.ui.view">
        <field name="name">res.config.settings.intrastat</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_intrastat.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='intrastat_region_id']/../.."
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
